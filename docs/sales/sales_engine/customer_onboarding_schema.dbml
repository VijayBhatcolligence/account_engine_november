// =====================================================================
// fin · DebtorAccount: the customer's AR sub-ledger account in our books
// =====================================================================

Table fin.debtor_account [headercolor: #4F46E5] {
  debtor_account_id uuid [pk, note: 'DA-1']
  workspace_id text [not null]
  operated_party_id uuid [not null, note: 'our company OP-1']
  party_id uuid [not null, note: 'the customer P-1']
  party_standing_id uuid [note: 'its customer standing PS-1']
  opened_from_request_id uuid [not null]
  customer_code text [not null, note: 'C000001: the CA\'s own series, never built from the ledger code']
  account_name text [not null]
  debtor_category_code text [not null]
  ledger_account_code text [not null, note: 'rev 5 (was control_ledger_code; Manoj 13-Nov, built): the receivable ledger this customer posts to, copied from the category at opening; a later change is dated in the history (gap G6)']
  customer_type_code text [not null, note: 'b2b | b2c | b2g']
  resident_status text [not null]
  export_customer boolean [not null, default: false]
  sez_customer boolean [not null, default: false]
  e_invoice_applicable text [not null]
  tcs_applicability_confirmed text [not null]
  credit_or_cash text [not null]
  payment_terms_code text [not null]
  credit_days integer [note: 'NULL for a cash customer']
  security_deposit_amount "numeric(18,2)"
  collection_owner_contact_id uuid
  currency_code text [not null, default: 'INR']
  bill_wise_tracking boolean [not null, default: true]
  po_reference_rule text [not null]
  invoice_delivery_channel text [not null]
  invoice_format_note text
  ad_bank_name text
  export_category_code text
  lut_number text
  lut_valid_until date
  realisation_mode_code text
  firc_brc_tracking boolean
  edpms_softex_reference text
  posting_blocked boolean [not null, default: false]
  sales_blocked boolean [not null, default: false, note: 'no new orders or invoices (a credit hold is the Credit Controller\'s task)']
  refund_bank_account_id uuid [note: 'rev 4, optional: fin.party_bank_account of the SAME party, for refunds (excess payment, security deposit, credit note). Unverified until the first refund (the refund task verifies it)']
  remarks text
  version_number integer [not null, default: 1]
  opened_at timestamptz [not null]
  closed_at timestamptz [note: 'NULL = open']
  recorded_at timestamptz [not null, default: `now()`, note: 'rev 5: as built']
  updated_at timestamptz [not null, default: `now()`, note: 'rev 5: as built']

  Indexes {
    (workspace_id, debtor_account_id) [unique, name: 'debtor_account_workspace_identity_key', note: 'rev 5: the key every (workspace_id, debtor_account_id) foreign key points at (as built)']
    (workspace_id, operated_party_id, party_id) [unique, name: 'one_debtor_account_per_party', note: 'one customer account per party per company, however many GSTINs']
    (workspace_id, operated_party_id, customer_code) [unique]
    (workspace_id, operated_party_id, account_name) [unique]
  }
  Note: '''The twin of fin.creditor_account. Finance keeps the id and the money facts; the identity stays in P&C.
No balance column and no journal row: the balance is zero until the first invoice (T24), whose customer line posts to
ledger_account_code and names debtor_account_id (fin.journal_line). What it owes = Σ(debit − credit) of those lines.'''
}

Table fin.debtor_tax_registration [headercolor: #4F46E5] {
  debtor_tax_registration_id uuid [pk, note: 'TR-1 …']
  workspace_id text [not null]
  debtor_account_id uuid [not null]
  party_identifier_id uuid [not null, note: 'the GSTIN row in P&C (IN_GST)']
  registration_type text [not null, note: 'regular | composition | sez | government | other']
  is_default boolean [not null, default: false, note: 'the form\'s Default / Billing GSTIN']
  remarks text
  since date
  until date

  Indexes {
    (debtor_account_id, party_identifier_id) [unique]
    (debtor_account_id) [unique, name: 'one_default_registration', note: 'WHERE is_default AND until IS NULL']
  }
  Note: 'How the account treats each GSTIN (twin of fin.creditor_tax_registration). The number stays in P&C; Finance keeps the type and the default.'
}

Table fin.debtor_location [headercolor: #4F46E5] {
  debtor_location_id uuid [pk, note: 'DL-1 … (rev 3: debtor_billing_location; the app calls a bill-to place a branch)']
  workspace_id text [not null]
  debtor_account_id uuid [not null]
  business_location_id uuid [not null, note: 'the customer place in P&C']
  usage text [not null, note: 'rev 4: bill_to | ship_to']
  debtor_tax_registration_id uuid [note: 'bill_to: the GSTIN it is billed under (NULL = billed as unregistered) · ship_to: NULL']
  is_primary boolean [not null, default: false, note: 'bill_to: the main place of that registration · ship_to: the default delivery place']
  since date [not null]
  until date [note: 'deactivated: no new invoices or deliveries to it']
  remarks text

  Indexes {
    (debtor_account_id, business_location_id, usage) [unique, name: 'one_open_location_per_usage', note: 'WHERE until IS NULL: one place can be both bill-to and ship-to (two rows)']
    (debtor_tax_registration_id) [unique, name: 'one_primary_per_registration', note: 'WHERE usage = \'bill_to\' AND is_primary AND until IS NULL']
    (debtor_account_id) [unique, name: 'one_default_ship_to', note: 'WHERE usage = \'ship_to\' AND is_primary AND until IS NULL']
  }
  Note: '''EXTRA to the vendor model: the customer places we use, and how. We bill customers and ship to them; vendors bill us.
bill_to: which place we bill under which GSTIN. P&C links a GSTIN to a party, not to a place; its model leaves
"registration, or accounting branch" to the domain. One GSTIN can serve several places; a place has one GSTIN at a time.
Invoice default = the default registration → its primary bill_to place. A B1 GSTIN with no address has a registration row
and no place yet (added later).
ship_to (rev 4): where goods go. Written at approval from the shipping address, only if the form gives one. No ship_to row =
goods go to the default bill_to place. The ship-to state decides the place of supply for goods (IGST Act s.10(1)(a)); the
invoice prints it as the delivery address (CGST Rule 46); the e-way bill takes its PIN.
CHECKS: usage IN (bill_to, ship_to) · ship_to ⇒ debtor_tax_registration_id IS NULL · since < until.
If P&C adopts registration_place (Branch Design, gap G8), the bill_to GSTIN link becomes a P&C read.'''
}

Table fin.debtor_credit_limit [headercolor: #4F46E5] {
  debtor_credit_limit_id uuid [pk, note: 'CL-1']
  workspace_id text [not null]
  debtor_account_id uuid [not null]
  credit_limit_amount "numeric(18,2)" [not null]
  currency_code text [not null, default: 'INR']
  effective_from date [not null]
  effective_until date [note: 'NULL = the current limit']
  approved_by_contact_id uuid [not null, note: 'the Credit Controller (Farid)']
  source_request_id uuid [note: 'the request that set it']
  reason text

  Indexes {
    (debtor_account_id) [unique, name: 'one_current_limit', note: 'WHERE effective_until IS NULL']
  }
  Note: 'EXTRA to the vendor model: a dated credit limit, never overwritten. T12\'s other trigger (a new limit from the Credit Controller) adds a row and closes the old one.'
}

Table fin.party_bank_account [headercolor: #4F46E5] {
  party_bank_account_id uuid [pk, note: 'BA-1']
  workspace_id text [not null]
  party_id uuid [not null, note: 'the party the account belongs to (customer, vendor, or both)']
  account_no text [not null]
  ifsc text [not null, note: '^[A-Z]{4}0[A-Z0-9]{6}$; SWIFT / IBAN for a foreign bank: Q15 in Manoj ER']
  beneficiary_name text [not null]
  bank_name text [not null]
  branch text
  proof_attached boolean [not null, default: false]
  verified_at timestamptz [note: 'NULL until verified (penny-drop)']
  verification_ref text
  since date
  until date
  recorded_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (workspace_id, party_id, party_bank_account_id) [unique, note: 'lets an account point only at a bank account of its own party']
    (workspace_id, party_id, ifsc, account_no) [unique, name: 'one_open_bank_row_per_party', note: 'WHERE until IS NULL']
    (workspace_id, ifsc, account_no) [name: 'bank_account_in_use_ix', note: 'the BANK_ACCOUNT_IN_USE check: the same account on another party']
  }
  Note: '''rev 4. SHARED with the vendor side: Manoj's table, same columns. It belongs to the PARTY, so a customer who is also our vendor
keeps one row, and both accounts can point at it. Optional for a customer (not on the CA form; Vijay, 6-Nov): for refunds of
an excess payment, a security deposit or a credit note, and to recognise the customer's receipts in the bank statement.
Written by OpenDebtorAccount only when the form gives the bank details (reused when the same party already holds it).
A customer needs no penny-drop at onboarding: the account is verified before the first refund is paid (the refund task).
Owner to review with Manoj (his Q1: P&C keeps bank accounts out of its model on purpose).'''
}

Table fin.debtor_account_history [headercolor: #4F46E5] {
  history_id uuid [pk, note: 'AH-1']
  workspace_id text [not null]
  debtor_account_id uuid [not null]
  version_number integer [not null]
  operation text [not null, note: 'open | change | add_location | end_location | set_default_registration | change_ledger | change_credit_limit | change_refund_bank | block | close']
  performer_contact_id uuid
  reason text
  row_snapshot jsonb [not null]
  recorded_at timestamptz [not null, default: `now()`]
  Note: 'One row per version of the account (as fin.creditor_account_history).'
}

