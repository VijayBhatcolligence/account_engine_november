Ref: fin.customer_request.(workspace_id, submitted_by_contact_id) > pc.contact.(workspace_id, contact_id) [color: #9ca3af]  // rev 4 (F2)
Ref: fin.customer_request.(workspace_id, collection_owner_contact_id) > pc.contact.(workspace_id, contact_id) [color: #9ca3af]  // rev 4 (F2)
