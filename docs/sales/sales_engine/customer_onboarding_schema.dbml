// =====================================================================
// fin · the link to the accounting engine
// =====================================================================

Table fin.outbox [headercolor: #4F46E5] {
  event_id uuid [pk, note: 'EV-1: the idempotency key']
  workspace_id text [not null]
  event_type text [not null, note: 'DebtorAccountOpened · DebtorBillingLocationAdded · DebtorCreditLimitChanged …']
  event_version integer [not null, default: 1]
  aggregate_type text [not null, note: 'debtor_account']
  aggregate_id uuid [not null]
  payload jsonb [not null]
  occurred_at timestamptz [not null]
  published_at timestamptz [note: 'NULL = not yet sent']
  Note: '''EXTRA, kept: the event is the only link from a slice to the accounting engine (our engine model).
The engine logs DebtorAccountOpened as seen and posts nothing (a master, not a transaction). Written in the same transaction.'''
}

// =====================================================================
// Decisions in this revision, and what stays open
// =====================================================================
// 1. Company key = pc.operated_party.operated_party_id (as the vendor side). rev 2's fin.book (book_party_id) is removed:
//    more books per company is task S1 (gap G1). The team's idea holds: P&C's id, no legal_entity_id.
// 2. One transaction on the last approval (Manoj's flow): no reactions, no hold stage, no handled_event / action_receipt.
// 3. Three approval parts (the app): fin.customer_request_approval. Closes gap G9 by design, to confirm with the role owner.
// 4. The category decides ledger, GST and TCS (as the vendor side). The app's "Edit" on those suggestion rows has no column:
//    if the CA wants per-customer overrides, add them on fin.debtor_account. Open with the CA.
// 5. A control account per category (gap G6) is now the category's ledger_account_code; moving an account is a dated
//    history row (change_control_ledger) plus a transfer entry by the engine.
// 6. P&C must seed: standing type customer, capacity customer_contact, legal forms beyond IN_PVT_LTD
//    (partnership, LLP, HUF, trust / society, government, foreign), and confirm the party_relationship type for customer groups (gap G5).
// 7. The app shows the LUT as one field (here lut_number + lut_valid_until) and the collection owner as text (here a contact).
//
// Rev 4 (6-Nov): our faults corrected (F1–F5) and the bank account added: see the header.
// To agree with Manoj (decisions, not faults; nothing here changed until agreed):
// 8.  Approval: three parts (here, as the app and the T12 card) or the Accounts Manager alone (his merged ER, 5-Nov). Gap G9.
// 9.  fin.outbox: kept here (our engine model: the event is the only link); removed in his merged ER. Ask the team lead.
// 10. posting_blocked / sales_blocked on debtor_account and legacy on gst_state_code: kept here; removed in his merged ER.
// 11. A GSTIN with no address: here no location row until the address comes; his vendor side writes one. One rule for both.
// 12. Names: created_by_contact_id / constitution_code (here) vs created_by / legal_form_code (vendor). One convention.
// 13. Paper form fields (paper_form_number, handed_over_by_contact_id): here only; his vendor_request has none.
// 14. P&C must also seed IN_UDYAM; the contact display name when the form gives no contact person (placeholder: the customer name).

// #####################################################################################################################
// REV 5 ADD-ON · T24 Sales voucher entry (raise a sales invoice) · T24 rev 2 · 16-Nov-2026 (Vijay)
// The twin of Manoj's purchase voucher (T1), as BUILT in the engine repo (aikyat-business-engine-poc, branch
// manoj/vendor-backend-model, commit 923409b, migrations 0004–0006). Same stages, names, history, gates and posting
// (PostJournalEntry); sales-only parts are marked EXTRA with the reason. The app (app/sales, T24) is the field source.
// #####################################################################################################################

// =====================================================================
// fin · the books core: Manoj's tables AS BUILT (migration 0005, 13-Nov). NOT ours: copied so the sales voucher's
// links are drawn and checked. Changed only where a column or check says "T24 rev 2" (additive).
// =====================================================================

Table fin.branch [headercolor: #B45309] {
  branch_id uuid [pk, default: `gen_random_uuid()`, note: 'seeded: KA-01 6b1d0a52-0001-4f0e-8a51-5c0b7a000001 · TN-01 6b1d0a52-0002-4f0e-8a51-5c0b7a000002']
  workspace_id text [not null]
  operated_party_id uuid [not null]
  branch_code text [not null, note: 'KA-01 · TN-01']
  display_name text [not null, note: 'Bengaluru plant and HQ · Hosur unit']
  business_location_id uuid [not null, note: 'our place in P&C']
  gst_identifier_id uuid [not null, note: 'our GSTIN in P&C (IN_GST): 29AAECA0000A1ZQ · 33AAECA0000A1Z1']
  since date
  until date
  checks {
    `btrim(branch_code) <> ''` [name: 'branch_code_not_blank']
    `since < until` [name: 'branch_period_is_ordered']
  }
  Indexes {
    (workspace_id, branch_id) [unique, name: 'branch_workspace_identity_key']
    (workspace_id, operated_party_id, branch_code) [unique, name: 'branch_code_per_company']
  }
  Note: '''Manoj's (0005). Our own branches: the stub of task S3 (gap G7). Every journal line carries one.
T24: the voucher carries the branch (our GSTIN) that issued the invoice; its journal lines carry it too.'''
}

Table fin.fiscal_year [headercolor: #B45309] {
  fiscal_year_id uuid [pk, default: `gen_random_uuid()`]
  workspace_id text [not null]
  operated_party_id uuid [not null]
  label text [not null, note: 'FY 2026-27']
  start_date date [not null]
  end_date date [not null]
  is_closed boolean [not null, default: false]
  closed_by_contact_id uuid
  closed_at timestamptz
  checks {
    `is_closed = (closed_at IS NOT NULL)` [name: 'fiscal_year_closed_has_a_time']
    `start_date < end_date` [name: 'fiscal_year_period_is_ordered']
  }
  Indexes {
    (workspace_id, fiscal_year_id) [unique, name: 'fiscal_year_workspace_identity_key']
    (workspace_id, operated_party_id, start_date) [unique, name: 'fiscal_year_start_per_company']
  }
  Note: '''Manoj's (0005). Period control at year level (FINANCIAL_YEAR_CLOSED). Seeded FY 2025-26 to FY 2027-28, none closed.
Also in the migration: EXCLUDE no overlap (btree_gist). Month-level soft / hard close (the app's K7, K8) is not here: gap G27.'''
}

Table fin.document_sequence [headercolor: #B45309] {
  workspace_id text [not null]
  operated_party_id uuid [not null]
  document_type text [not null, note: 'purchase_invoice (PV-0001) · T24: sales_invoice (SV-0001); one row per voucher type']
  last_number integer [not null]
  checks {
    `last_number >= 0` [name: 'document_sequence_not_negative']
  }
  Indexes {
    (workspace_id, operated_party_id, document_type) [pk]
  }
  Note: '''Manoj's (0005). The INTERNAL reference, company-wide (INSERT … ON CONFLICT DO UPDATE … RETURNING: the row lock serialises two savers).
T24 uses it for sales_invoice.internal_ref_no (SV-nnnn). The GST invoice number is Billing's.'''
}

Table fin.journal_entry [headercolor: #B45309] {
  journal_entry_id uuid [pk, default: `gen_random_uuid()`, note: 'JE-…']
  workspace_id text [not null]
  operated_party_id uuid [not null]
  fiscal_year_id uuid [not null]
  branch_id uuid [not null, note: 'T24: the branch (GSTIN) that issued the invoice']
  posting_date date [not null, note: 'T24: = the invoice date']
  voucher_type text [not null, note: 'purchase | opening | T24 rev 2: sales']
  source_document_id uuid [note: 'T24: fin.sales_invoice.sales_invoice_id (his: fin.purchase_invoice). No FK: it points at the voucher of its voucher_type (as built)']
  source_ref_no text [note: 'the voucher number: PV-0001 (his) · SV-0012 (T24), as his post_purchase_invoice writes internal_ref_no']
  reverses_journal_entry_id uuid [note: 'a reversal (the exact mirror)']
  narration text
  posted_by_contact_id uuid [note: 'T24: the Accounts Manager who approved']
  posted_at timestamptz [not null, default: `now()`]
  checks {
    `voucher_type IN ('purchase', 'opening', 'sales')` [name: 'journal_entry_voucher_type_valid']
    `reverses_journal_entry_id <> journal_entry_id` [name: 'journal_entry_does_not_reverse_itself']
  }
  Indexes {
    (workspace_id, journal_entry_id) [unique, name: 'journal_entry_workspace_identity_key']
    (workspace_id, reverses_journal_entry_id) [unique, name: 'journal_entry_reversed_once']
    (workspace_id, voucher_type, source_document_id) [unique, name: 'journal_entry_one_forward_entry_per_document', note: 'WHERE reverses_journal_entry_id IS NULL AND source_document_id IS NOT NULL: an invoice never posts twice']
    (workspace_id, operated_party_id, posting_date) [name: 'journal_entry_posting_date_idx']
  }
  Note: '''Manoj's (0005), written once (append-only trigger). T24 rev 2 changes ONE thing: voucher_type also allows 'sales'
(the CHECK is dropped and re-added; his rows are untouched; T1 is checked again).
At commit, fin.check_journal_entry refuses an entry that breaks any of 8 rules (HINT = the code): ENTRY_NOT_BALANCED ·
ENTRY_ACROSS_COMPANIES · ENTRY_OUTSIDE_ITS_YEAR · FINANCIAL_YEAR_CLOSED · POSTED_TO_A_GROUP · SUBLEDGER_MISMATCH ·
ACCOUNT_NOT_ON_ITS_LEDGER · REVERSAL_NOT_A_MIRROR. The sales voucher posts through the same journal.PostJournalEntry.'''
}

Table fin.journal_line [headercolor: #B45309] {
  journal_line_id uuid [pk, default: `gen_random_uuid()`]
  workspace_id text [not null]
  journal_entry_id uuid [not null]
  line_no integer [not null]
  ledger_account_code text [not null, note: 'always a ledger; the customer line: the account\'s own receivable ledger (107100 …)']
  creditor_account_id uuid [note: 'set on a vendor\'s line']
  debtor_account_id uuid [note: 'set on a customer\'s line (T24): the subledger is these lines grouped by account']
  branch_id uuid [not null]
  debit "numeric(18,2)" [not null, default: 0]
  credit "numeric(18,2)" [not null, default: 0]
  checks {
    `(debit > 0) <> (credit > 0)` [name: 'journal_line_debit_or_credit']
    `debit >= 0 AND credit >= 0` [name: 'journal_line_not_negative']
    `creditor_account_id IS NULL OR debtor_account_id IS NULL` [name: 'journal_line_vendor_or_customer']
  }
  Indexes {
    (workspace_id, journal_entry_id, line_no) [unique, name: 'journal_line_no_key']
    (workspace_id, debtor_account_id) [name: 'journal_line_debtor_idx']
    (workspace_id, creditor_account_id) [name: 'journal_line_creditor_idx']
    (workspace_id, ledger_account_code) [name: 'journal_line_ledger_idx']
    (workspace_id, branch_id, ledger_account_code) [name: 'journal_line_branch_ledger_idx']
  }
  Note: '''Manoj's (0005), unchanged. One line per fin.sales_invoice_line at Post. What a customer owes =
Σ(debit − credit) of its lines (journal.debtor_balance, the twin of creditor_balance); it always adds up to the receivable ledgers.'''
}

Ref: fin.branch.(workspace_id, operated_party_id) > pc.operated_party.(workspace_id, operated_party_id) [color: #9ca3af]
Ref: fin.branch.(workspace_id, business_location_id) > pc.business_location.(workspace_id, business_location_id) [color: #9ca3af]
Ref: fin.branch.gst_identifier_id > pc.party_identifier.party_identifier_id [color: #9ca3af]
Ref: fin.fiscal_year.(workspace_id, operated_party_id) > pc.operated_party.(workspace_id, operated_party_id) [color: #9ca3af]
Ref: fin.fiscal_year.(workspace_id, closed_by_contact_id) > pc.contact.(workspace_id, contact_id) [color: #9ca3af]
Ref: fin.document_sequence.(workspace_id, operated_party_id) > pc.operated_party.(workspace_id, operated_party_id) [color: #9ca3af]
Ref: fin.journal_entry.(workspace_id, operated_party_id) > pc.operated_party.(workspace_id, operated_party_id) [color: #9ca3af]
Ref: fin.journal_entry.(workspace_id, fiscal_year_id) > fin.fiscal_year.(workspace_id, fiscal_year_id)
Ref: fin.journal_entry.(workspace_id, branch_id) > fin.branch.(workspace_id, branch_id)
Ref: fin.journal_entry.(workspace_id, reverses_journal_entry_id) > fin.journal_entry.(workspace_id, journal_entry_id)
Ref: fin.journal_entry.(workspace_id, posted_by_contact_id) > pc.contact.(workspace_id, contact_id) [color: #9ca3af]
Ref: fin.journal_line.(workspace_id, journal_entry_id) > fin.journal_entry.(workspace_id, journal_entry_id)
Ref: fin.journal_line.ledger_account_code > fin.ledger_account.account_code
Ref: fin.journal_line.(workspace_id, debtor_account_id) > fin.debtor_account.(workspace_id, debtor_account_id)
Ref: fin.journal_line.(workspace_id, branch_id) > fin.branch.(workspace_id, branch_id)
// (journal_line.creditor_account_id → fin.creditor_account: Manoj's vendor table, not drawn in this customer-side file.)

// =====================================================================
// fin · T24 SALES VOUCHER (rev 14): the TWIN of Manoj's purchase voucher, as built (migration 0005).
//   fin.purchase_invoice          ↔ fin.sales_invoice          the voucher (one per invoice booked)
//   fin.purchase_invoice_line     ↔ fin.sales_invoice_line     the Dr / Cr lines the AE sends
//   fin.purchase_invoice_history  ↔ fin.sales_invoice_history  one row per version (append-only)
// Approve posts through the SHARED books: journal.post_journal_entry → fin.journal_entry + fin.journal_line.
// As his: no GST columns (GST = lines on the output GST ledgers, found by account_type), no rule table (the rules
// R1–R12 fill the form in code and are never stored), no balances (what a customer owes = its journal lines).
// The backend record is "sales_invoice" as his is "purchase_invoice"; the screen and the task keep "Sales Voucher" (SV-0012).
// It is NOT Billing's invoice: no items, HSN, IRN or e-way bill here; only what the accounting entry needs.
// =====================================================================

Table fin.sales_invoice [headercolor: #15803D] {
  sales_invoice_id uuid [pk, default: `gen_random_uuid()`]
  workspace_id text [not null]
  operated_party_id uuid [not null, note: 'our company']
  branch_id uuid [not null, note: 'our branch (GSTIN) that issued the invoice: KA-01. Its journal lines carry it']
  debtor_account_id uuid [note: 'the customer (T12). NULL only for a B2C sale paid at once (cash / UPI, the CA\'s A3): there is no customer line']
  internal_ref_no text [not null, note: 'SV-0012: fin.document_sequence \'sales_invoice\' (his PV-0001). An amendment: SV-0012-1']
  amends_sales_invoice_id uuid [note: 'the posted voucher this one corrects (his amends_purchase_invoice_id)']
  original_sales_invoice_id uuid [not null, note: 'the first voucher of the chain (itself when revision 0)']
  revision_no integer [not null, default: 0, note: '0 = the first; 1, 2 … = amendments']
  posting_date date [not null, note: 'the date the entry posts on (normally the invoice date)']
  invoice_no text [not null, note: 'Billing\'s invoice number KA/INV/2627/0143 (his supplier_invoice_no)']
  invoice_key text [not null, note: 'GENERATED: upper(invoice_no) without spaces (his supplier_invoice_key): the never-twice key']
  invoice_date date [not null, note: '07-Oct-2026']
  due_date date [not null, note: 'invoice date + the customer\'s credit days (30): 06-Nov-2026. Paid at once: the invoice date']
  invoice_financial_year integer [not null, note: 'GENERATED: the April year of invoice_date (2026)']
  narration text [note: 'Being goods sold to Sri Lakshmi Distributors: copied to the journal entry']
  costing_method text [note: 'rev 15: fifo | weighted_average, the company\'s method when the cost lines were made (the "why" of their amounts). NULL: no goods (services only)']
  stage text [not null, note: 'submitted | posted | rejected | draft (sent back) | amended']
  version_number integer [not null, default: 1]
  submitted_by_contact_id uuid [not null, note: 'the maker: Teja (AE)']
  submitted_at timestamptz [not null]
  decided_by_contact_id uuid [note: 'the checker: Rajan (Accounts Manager); never the maker']
  decided_at timestamptz
  decision_reason text [note: 'why rejected or sent back']
  journal_entry_id uuid [note: 'the posted entry (JE-233)']
  recorded_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `btrim(invoice_no) <> ''` [name: 'sales_invoice_invoice_no_not_blank']
    `stage IN ('draft', 'submitted', 'posted', 'rejected', 'amended')` [name: 'sales_invoice_stage_valid']
    `stage NOT IN ('posted', 'amended') OR journal_entry_id IS NOT NULL` [name: 'sales_invoice_posted_has_journal']
    `stage NOT IN ('posted', 'amended', 'rejected') OR (decided_by_contact_id IS NOT NULL AND decided_at IS NOT NULL)` [name: 'sales_invoice_decided_has_decider']
    `(revision_no = 0) = (amends_sales_invoice_id IS NULL)` [name: 'sales_invoice_revision_matches_amends']
    `decided_by_contact_id IS NULL OR decided_by_contact_id <> submitted_by_contact_id` [name: 'sales_invoice_maker_may_not_decide']
    `due_date >= invoice_date` [name: 'sales_invoice_due_after_invoice']
    `revision_no > 0 OR original_sales_invoice_id = sales_invoice_id` [name: 'sales_invoice_original_is_itself']
    `costing_method IN ('fifo', 'weighted_average')` [name: 'sales_invoice_costing_method_valid']
  }
  Indexes {
    (workspace_id, sales_invoice_id) [unique, name: 'sales_invoice_workspace_identity_key']
    (workspace_id, operated_party_id, internal_ref_no) [unique, name: 'sales_invoice_internal_ref_no_key']
    (workspace_id, amends_sales_invoice_id) [unique, name: 'sales_invoice_one_open_amendment', note: 'WHERE stage IN (\'draft\', \'submitted\'): one correction at a time']
    (workspace_id, stage) [name: 'sales_invoice_stage_idx', note: 'the lists: to decide (submitted), sent back (draft), posted']
    (workspace_id, debtor_account_id) [name: 'sales_invoice_debtor_idx', note: 'a customer\'s vouchers']
  }
  Note: '''T24: the twin of fin.purchase_invoice. One row per Billing invoice the AE books; created at Submit (as his).
FLOW: Submit (AE) → submitted ─Decide (Accounts Manager, not the maker)→ approve: every gate again + PostJournalEntry in one
transaction → posted · reject → rejected · send_back → draft → Submit again. An amendment (a posted voucher corrected) is a new
row with amends_ / revision_no; its approval reverses the old entry and posts the new one; the old row becomes amended.
NEVER TWICE (by hand in the migration, as his purchase_invoice_never_twice): EXCLUDE USING gist (workspace_id WITH =,
branch_id WITH =, invoice_key WITH =, invoice_financial_year WITH =, original_sales_invoice_id WITH <>)
WHERE (stage NOT IN ('rejected', 'amended')): Billing\'s invoice number is booked once per GSTIN and year.
GATES at Submit and again at Approve (his + the sales ones): MISSING_REQUIRED_DETAILS · BRANCH_NOT_VALID · LEDGER_OR_CUSTOMER ·
AMOUNT_NOT_VALID · LEDGER_NOT_POSTABLE · CUSTOMER_NOT_FOUND · DEBTOR_ACCOUNT_CLOSED · CUSTOMER_LINE_ON_CREDIT · NO_CUSTOMER_LINE
(unless paid at once) · MANY_CUSTOMERS · DUPLICATE_INVOICE · GST_HEAD_MISMATCH (same state → CGST + SGST; other state → IGST) ·
DEBITS_CREDITS_DIFFER · NOT_AS_INVOICED (the customer, GST and total lines must equal Billing\'s invoice) · rev 15: NO_STOCK_RECORD ·
STOCK_SHORT · COST_NOT_AS_INVENTORY (the cost lines = the lots by costing_method; FIFO names its lot, weighted average none) ·
STOCK_LINE_NEEDS_ITEM (a stock ledger line names its item) · AMEND_NOT_POSTED ·
AMENDMENT_PENDING · FINANCIAL_YEAR_CLOSED · MAKER_MAY_NOT_DECIDE · NO_REASON_GIVEN.
DIFFERENCES FROM HIS (deliberate): no source_extraction_id (no PDF: Billing hands the invoice over, G37); debtor_account_id may
be NULL (a B2C sale paid at once, his vendor is always there); the never-twice key is per branch, not per party (the number is
ours, unique per GSTIN per year).'''
}

Table fin.sales_invoice_line [headercolor: #15803D] {
  sales_invoice_line_id uuid [pk, default: `gen_random_uuid()`]
  workspace_id text [not null]
  sales_invoice_id uuid [not null]
  line_no integer [not null, note: '1, 2, 3 … (Screen: #)']
  side text [not null, note: 'Dr | Cr']
  ledger_account_code text [note: 'a ledger line: 401010 Sale of Products · 206011 Output CGST … (suggested by the rule, the AE may pick another)']
  debtor_account_id uuid [note: 'the customer line (instead of a ledger): posts to the customer account\'s own receivable ledger']
  inventory_item_code text [note: 'rev 15 (his purchase line has it): the item whose cost leaves stock on this line: FG-101. Set only on a Cr stock line (106020)']
  quantity "numeric(18,3)" [note: 'rev 15: the quantity that leaves stock: 300 (cartons). With the item, never without']
  stock_lot_id uuid [note: 'rev 15: FIFO: the lot it came from (G-2604). NULL under weighted average (all lots, at the average)']
  amount "numeric(18,2)" [not null, note: '7,48,125.00']
  checks {
    `side IN ('Dr', 'Cr')` [name: 'sales_invoice_line_side_valid']
    `(ledger_account_code IS NULL) <> (debtor_account_id IS NULL)` [name: 'sales_invoice_line_ledger_or_customer']
    `debtor_account_id IS NULL OR side = 'Dr'` [name: 'sales_invoice_line_customer_is_debit']
    `amount > 0` [name: 'sales_invoice_line_amount_positive']
    `(inventory_item_code IS NULL) = (quantity IS NULL)` [name: 'sales_invoice_line_item_has_quantity']
    `quantity IS NULL OR quantity > 0` [name: 'sales_invoice_line_quantity_positive']
    `stock_lot_id IS NULL OR inventory_item_code IS NOT NULL` [name: 'sales_invoice_line_lot_needs_item']
    `inventory_item_code IS NULL OR (side = 'Cr' AND ledger_account_code IS NOT NULL)` [name: 'sales_invoice_line_item_on_a_stock_credit']
  }
  Indexes {
    (workspace_id, sales_invoice_id, line_no) [unique, name: 'sales_invoice_line_no_key']
  }
  Note: '''T24: the twin of fin.purchase_invoice_line: side, a ledger OR the customer, amount. Replaced whole on each Submit.
At Post: one journal_line per row, same order; the customer line goes to its account\'s ledger (107100) naming the account.
His vendor line must be Cr; our customer line must be Dr (a sale debits the customer).
Rev 15 (R13): the cost lines: Dr 501040 Cost of Goods Sold (the total) · Cr 106020 Finished Goods per lot (FIFO) or per item
(weighted average), each naming its item and quantity (and its lot under FIFO). B4-01, FIFO: 300 FG-101 from G-2604 at ₹540 +
300 from G-2608 at ₹560 + 300 FG-102 from C-2607 at ₹760 = ₹5,58,000.00 (lot costs illustrative). The item has no foreign key:
the item master is in code until T8 (G20).'''
}

Table fin.sales_invoice_history [headercolor: #15803D] {
  history_id uuid [pk, default: `gen_random_uuid()`]
  workspace_id text [not null]
  sales_invoice_id uuid [not null]
  version_number integer [not null]
  operation text [not null, note: 'submit | decide | amended']
  row_snapshot jsonb [not null, note: 'the voucher row as it then stood']
  performer_contact_id uuid [note: 'who did it (Teja, Rajan)']
  acting_on_event_id uuid [note: 'set when an event did it, not a person']
  reason text [note: 'the decision reason']
  recorded_at timestamptz [not null, default: `now()`]
  checks {
    `operation IN ('submit', 'decide', 'amended')` [name: 'sales_invoice_history_operation_valid']
    `performer_contact_id IS NOT NULL OR acting_on_event_id IS NOT NULL` [name: 'sales_invoice_history_has_an_actor']
  }
  Indexes {
    (workspace_id, sales_invoice_id, version_number) [unique, name: 'sales_invoice_history_one_per_version']
  }
  Note: 'T24: the twin of fin.purchase_invoice_history. One row per version, append-only (trigger). Screen: Approval & history.'
}

Ref: fin.sales_invoice.(workspace_id, operated_party_id) > pc.operated_party.(workspace_id, operated_party_id) [color: #9ca3af]
Ref: fin.sales_invoice.(workspace_id, branch_id) > fin.branch.(workspace_id, branch_id)
Ref: fin.sales_invoice.(workspace_id, debtor_account_id) > fin.debtor_account.(workspace_id, debtor_account_id)
Ref: fin.sales_invoice.(workspace_id, amends_sales_invoice_id) > fin.sales_invoice.(workspace_id, sales_invoice_id)
Ref: fin.sales_invoice.(workspace_id, original_sales_invoice_id) > fin.sales_invoice.(workspace_id, sales_invoice_id)
Ref: fin.sales_invoice.(workspace_id, submitted_by_contact_id) > pc.contact.(workspace_id, contact_id) [color: #9ca3af]
Ref: fin.sales_invoice.(workspace_id, decided_by_contact_id) > pc.contact.(workspace_id, contact_id) [color: #9ca3af]
Ref: fin.sales_invoice.(workspace_id, journal_entry_id) > fin.journal_entry.(workspace_id, journal_entry_id)
Ref: fin.sales_invoice_line.(workspace_id, sales_invoice_id) > fin.sales_invoice.(workspace_id, sales_invoice_id) [delete: cascade]
Ref: fin.sales_invoice_line.(workspace_id, debtor_account_id) > fin.debtor_account.(workspace_id, debtor_account_id)
