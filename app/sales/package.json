{
  "name": "accounts-executive-app",
  "private": true,
  "version": "0.1.0",
  "description": "Aikyat position app: Accounts Executive (R01). Desktop UI, scenario data; saves to PostgreSQL (the engine schema) through its own backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "db:init": "vite-node scripts/db.ts init",
    "db:start": "vite-node scripts/db.ts start",
    "db:stop": "vite-node scripts/db.ts stop",
    "db:setup": "vite-node scripts/db.ts setup",
    "db:reset": "vite-node scripts/db.ts reset",
    "db:status": "vite-node scripts/db.ts status",
    "db:e2e": "vite-node scripts/e2e.ts"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "lucide-react": "0.460.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
