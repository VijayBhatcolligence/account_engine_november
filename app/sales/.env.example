# Where the app saves its data. ONE line; copy this file to .env.local and change it when the database moves.
# Local (npm run db:init makes it on this computer):
DATABASE_URL=postgresql://aikyat@localhost:55440/aikyat_ae
# Docker (docker compose up -d):
# DATABASE_URL=postgresql://aikyat:aikyat@localhost:5432/aikyat_ae
# Supabase (Project settings → Database → connection string; keep the password out of git):
# DATABASE_URL=postgresql://postgres.<project>:<password>@<host>:5432/postgres?sslmode=require
